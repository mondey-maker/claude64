diff --git a/src/pc/platform.c b/src/pc/platform.c
index 2eba403..9717248 100644
--- a/src/pc/platform.c
+++ b/src/pc/platform.c
@@ -296,6 +296,60 @@ static void sys_fatal_impl(const char *msg) {
 
 #include <SDL2/SDL.h>
 
+#ifdef TARGET_ANDROID
+// ---- Android layout (package com.claude64.app) -------------------------------------------
+//   <external files>/user  -> baserom.z64, sm64coopdx.sav/config, saves, dynos packs the user adds
+//   <external files>/mods  -> user mods (a folder with main.lua / main.mod, or a single .lua / .mod)
+//   <internal files>/game  -> read-only game data unpacked from the APK (lang, mods, palettes, dynos)
+static const char *sys_android_base_path(void) {
+    static char base[SYS_MAX_PATH] = { 0 };
+    if ('\0' != base[0]) { return base; }
+    const char *p = SDL_AndroidGetExternalStoragePath();
+    if (p == NULL) { p = SDL_AndroidGetInternalStoragePath(); }
+    if (p == NULL) { return NULL; }
+    snprintf(base, SYS_MAX_PATH, "%s", p);
+    return base;
+}
+
+static const char *sys_android_subdir(char *out, const char *base, const char *sub) {
+    if ('\0' != out[0]) { return out; }
+    if (base == NULL) { return NULL; }
+    snprintf(out, SYS_MAX_PATH, "%s/%s", base, sub);
+    fs_sys_mkdir(out);
+    return out;
+}
+
+const char *sys_user_path(void) {
+    static char path[SYS_MAX_PATH] = { 0 };
+    return sys_android_subdir(path, sys_android_base_path(), "user");
+}
+
+const char *sys_android_mods_path(void) {
+    static char path[SYS_MAX_PATH] = { 0 };
+    return sys_android_subdir(path, sys_android_base_path(), "mods");
+}
+
+const char *sys_resource_path(void) {
+    static char path[SYS_MAX_PATH] = { 0 };
+    if ('\0' != path[0]) { return path; }
+    const char *p = SDL_AndroidGetInternalStoragePath();
+    if (p == NULL) { return NULL; }
+    snprintf(path, SYS_MAX_PATH, "%s/game", p);
+    return path;
+}
+
+const char *sys_exe_path_dir(void) {
+    return sys_resource_path();
+}
+
+const char *sys_exe_path_file(void) {
+    static char path[SYS_MAX_PATH] = { 0 };
+    if ('\0' != path[0]) { return path; }
+    snprintf(path, SYS_MAX_PATH, "%s/libmain.so", sys_resource_path());
+    return path;
+}
+
+#else // !TARGET_ANDROID
 const char *sys_user_path(void) {
     static char path[SYS_MAX_PATH] = { 0 };
     if ('\0' != path[0]) { return path; }
@@ -383,6 +437,8 @@ const char *sys_exe_path_file(void) {
     return path;
 }
 
+#endif // TARGET_ANDROID
+
 static void sys_fatal_impl(const char *msg) {
     SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR , "Fatal error", msg, NULL);
     fprintf(stderr, "FATAL ERROR:\n%s\n", msg);
