diff --git a/src/pc/controller/controller_touch.c b/src/pc/controller/controller_touch.c
new file mode 100644
index 0000000..066e7f5
--- /dev/null
+++ b/src/pc/controller/controller_touch.c
@@ -0,0 +1,302 @@
+#include <stdio.h>
+#include <string.h>
+#include <math.h>
+#include <stdbool.h>
+
+#include <SDL2/SDL.h>
+#include <ultra64.h>
+
+#include "controller_api.h"
+#include "controller_touch.h"
+#include "pc/djui/djui.h"
+#include "pc/djui/djui_panel_pause.h"
+#include "pc/djui/djui_hud_utils.h"
+
+#if defined(TARGET_ANDROID) || defined(ENABLE_TOUCH_CONTROLS)
+#define TOUCH_ENABLED 1
+#else
+#define TOUCH_ENABLED 0
+#endif
+
+#define MAX_FINGERS 10
+
+enum TouchButton {
+    TB_A, TB_B, TB_Z, TB_R, TB_START, TB_MENU,
+    TB_CUP, TB_CDOWN, TB_CLEFT, TB_CRIGHT,
+    TB_COUNT
+};
+
+// anchor: 0 = left edge, 1 = right edge, 2 = screen centre. cx/cy/r are in units of the screen height.
+struct TouchButtonDef {
+    const char *label;
+    int anchor;
+    float cx, cy;   // cy < 0 measures up from the bottom edge
+    float r;
+    u32 mask;       // N64 button mask, 0 for special buttons
+};
+
+static const struct TouchButtonDef sButtons[TB_COUNT] = {
+    [TB_A]      = { "A",     1, 0.17f, -0.21f, 0.100f, A_BUTTON },
+    [TB_B]      = { "B",     1, 0.37f, -0.13f, 0.080f, B_BUTTON },
+    [TB_Z]      = { "Z",     1, 0.35f, -0.33f, 0.075f, Z_TRIG },
+    [TB_R]      = { "R",     1, 0.11f,  0.11f, 0.065f, R_TRIG },
+    [TB_START]  = { "START", 2, 0.00f,  0.07f, 0.055f, START_BUTTON },
+    [TB_MENU]   = { "MENU",  0, 0.11f,  0.09f, 0.065f, 0 },
+    [TB_CUP]    = { "^",     1, 0.14f,  0.30f, 0.045f, U_CBUTTONS },
+    [TB_CDOWN]  = { "v",     1, 0.14f,  0.48f, 0.045f, D_CBUTTONS },
+    [TB_CLEFT]  = { "<",     1, 0.23f,  0.39f, 0.045f, L_CBUTTONS },
+    [TB_CRIGHT] = { ">",     1, 0.05f,  0.39f, 0.045f, R_CBUTTONS },
+};
+
+struct Finger {
+    bool active;
+    SDL_FingerID id;
+    float x, y;          // normalized 0..1
+    float ox, oy;        // where it went down
+    bool isStick;
+};
+
+static struct Finger sFingers[MAX_FINGERS];
+static bool sButtonDown[TB_COUNT];
+static bool sMenuWasDown = false;
+static float sScreenW = 1920.0f, sScreenH = 1080.0f;
+static float sStickX = 0, sStickY = 0;       // -1..1, y up
+static bool sStickActive = false;
+static float sStickOriginX = 0, sStickOriginY = 0; // in screen units
+static float sStickKnobX = 0, sStickKnobY = 0;
+static bool sSeenTouch = false;
+
+static const float STICK_RADIUS = 0.13f;     // in units of screen height
+static const float STICK_DEADZONE = 0.10f;
+
+bool touch_controls_active(void) {
+#if TOUCH_ENABLED
+    if (gDjuiDisabled || gDjuiInMainMenu || gDjuiPanelPauseCreated) { return false; }
+    return true;
+#else
+    return false;
+#endif
+}
+
+static void button_center(int i, float *x, float *y) {
+    const struct TouchButtonDef *b = &sButtons[i];
+    float w = sScreenW, h = sScreenH;
+    switch (b->anchor) {
+        case 0:  *x = b->cx * h; break;
+        case 1:  *x = w - b->cx * h; break;
+        default: *x = w * 0.5f + b->cx * h; break;
+    }
+    *y = (b->cy < 0) ? h + b->cy * h : b->cy * h;
+}
+
+static bool button_hit(int i, float px, float py) {
+    float cx, cy;
+    button_center(i, &cx, &cy);
+    float r = sButtons[i].r * sScreenH * 1.25f; // forgiving hit area
+    float dx = px - cx, dy = py - cy;
+    return (dx * dx + dy * dy) <= r * r;
+}
+
+static bool point_on_any_button(float px, float py) {
+    for (int i = 0; i < TB_COUNT; i++) {
+        if (button_hit(i, px, py)) { return true; }
+    }
+    return false;
+}
+
+static struct Finger *find_finger(SDL_FingerID id) {
+    for (int i = 0; i < MAX_FINGERS; i++) {
+        if (sFingers[i].active && sFingers[i].id == id) { return &sFingers[i]; }
+    }
+    return NULL;
+}
+
+void touch_controls_handle_event(const SDL_Event *e) {
+#if TOUCH_ENABLED
+    if (e->type != SDL_FINGERDOWN && e->type != SDL_FINGERMOTION && e->type != SDL_FINGERUP) { return; }
+    sSeenTouch = true;
+
+    struct Finger *f = find_finger(e->tfinger.fingerId);
+    if (e->type == SDL_FINGERDOWN) {
+        if (f == NULL) {
+            for (int i = 0; i < MAX_FINGERS; i++) {
+                if (!sFingers[i].active) { f = &sFingers[i]; break; }
+            }
+        }
+        if (f == NULL) { return; }
+        f->active = true;
+        f->id = e->tfinger.fingerId;
+        f->x = f->ox = e->tfinger.x;
+        f->y = f->oy = e->tfinger.y;
+        f->isStick = false;
+
+        // Left half of the screen (below the top bar) that is not on a button starts the floating stick.
+        float px = f->x * sScreenW, py = f->y * sScreenH;
+        if (!sStickActive && f->x < 0.5f && f->y > 0.2f && !point_on_any_button(px, py)) {
+            f->isStick = true;
+            sStickActive = true;
+            sStickOriginX = px;
+            sStickOriginY = py;
+        }
+    } else if (e->type == SDL_FINGERMOTION) {
+        if (f == NULL) { return; }
+        f->x = e->tfinger.x;
+        f->y = e->tfinger.y;
+    } else { // SDL_FINGERUP
+        if (f == NULL) { return; }
+        if (f->isStick) { sStickActive = false; sStickX = sStickY = 0; }
+        f->active = false;
+    }
+#endif
+}
+
+static void touch_update_state(void) {
+    for (int i = 0; i < TB_COUNT; i++) { sButtonDown[i] = false; }
+    sStickX = sStickY = 0;
+
+    for (int k = 0; k < MAX_FINGERS; k++) {
+        struct Finger *f = &sFingers[k];
+        if (!f->active) { continue; }
+        float px = f->x * sScreenW, py = f->y * sScreenH;
+        if (f->isStick) {
+            float R = STICK_RADIUS * sScreenH;
+            float dx = (px - sStickOriginX) / R;
+            float dy = (sStickOriginY - py) / R; // up positive
+            float mag = sqrtf(dx * dx + dy * dy);
+            if (mag > 1.0f) { dx /= mag; dy /= mag; mag = 1.0f; }
+            sStickKnobX = sStickOriginX + dx * R;
+            sStickKnobY = sStickOriginY - dy * R;
+            if (mag >= STICK_DEADZONE) {
+                // rescale so the dead zone does not eat into the usable range
+                float scale = (mag - STICK_DEADZONE) / (1.0f - STICK_DEADZONE) / mag;
+                sStickX = dx * scale;
+                sStickY = dy * scale;
+            }
+        } else {
+            for (int i = 0; i < TB_COUNT; i++) {
+                if (button_hit(i, px, py)) { sButtonDown[i] = true; }
+            }
+        }
+    }
+}
+
+static void touch_init(void) {
+    memset(sFingers, 0, sizeof(sFingers));
+    sStickActive = false;
+}
+
+static void touch_read(OSContPad *pad) {
+#if TOUCH_ENABLED
+    if (!touch_controls_active()) {
+        // a finger that is held while a menu opens must not stay stuck
+        sStickActive = false;
+        for (int k = 0; k < MAX_FINGERS; k++) { sFingers[k].active = false; }
+        sMenuWasDown = false;
+        return;
+    }
+    touch_update_state();
+
+    for (int i = 0; i < TB_COUNT; i++) {
+        if (sButtonDown[i] && sButtons[i].mask != 0) { pad->button |= sButtons[i].mask; }
+    }
+
+    if (sStickX != 0 || sStickY != 0) {
+        int x = (int)(sStickX * 127.0f);
+        int y = (int)(sStickY * 127.0f);
+        pad->stick_x = (s8)(x > 127 ? 127 : (x < -128 ? -128 : x));
+        pad->stick_y = (s8)(y > 127 ? 127 : (y < -128 ? -128 : y));
+    }
+
+    // MENU opens the pause / DJUI menu exactly like the Android Back button (Escape).
+    if (sButtonDown[TB_MENU] && !sMenuWasDown) {
+        SDL_Event ev;
+        memset(&ev, 0, sizeof(ev));
+        ev.type = SDL_KEYDOWN;
+        ev.key.state = SDL_PRESSED;
+        ev.key.keysym.scancode = SDL_SCANCODE_ESCAPE;
+        ev.key.keysym.sym = SDLK_ESCAPE;
+        SDL_PushEvent(&ev);
+        ev.type = SDL_KEYUP;
+        ev.key.state = SDL_RELEASED;
+        SDL_PushEvent(&ev);
+    }
+    sMenuWasDown = sButtonDown[TB_MENU];
+#else
+    (void) pad;
+#endif
+}
+
+static u32 touch_rawkey(void) { return VK_INVALID; }
+static void touch_reconfig(void) { }
+static void touch_shutdown(void) { }
+
+struct ControllerAPI controller_touch = {
+    VK_BASE_TOUCH,
+    touch_init,
+    touch_read,
+    touch_rawkey,
+    NULL,
+    NULL,
+    touch_reconfig,
+    touch_shutdown
+};
+
+// ---- overlay --------------------------------------------------------------------------------
+
+// A chamfered square (two overlapping rectangles + a core) reads as a round button without a circle primitive.
+static void render_blob(float cx, float cy, float r) {
+    float a = r * 0.92f, b = r * 0.52f;
+    djui_hud_render_rect(cx - a, cy - b, a * 2, b * 2);
+    djui_hud_render_rect(cx - b, cy - a, b * 2, a * 2);
+    float c = r * 0.74f;
+    djui_hud_render_rect(cx - c, cy - c, c * 2, c * 2);
+}
+
+static void render_label(const char *text, float cx, float cy, float h) {
+    float tw = 0, th = 0;
+    djui_hud_measure_text("A", &tw, &th);
+    if (th <= 0) { return; }
+    float scale = (0.045f * h) / th;
+    if (strlen(text) > 2) { scale *= 0.62f; }
+    djui_hud_measure_text(text, &tw, &th);
+    djui_hud_print_text(text, cx - tw * scale * 0.5f, cy - th * scale * 0.5f, scale, scale);
+}
+
+void touch_controls_render(void) {
+#if TOUCH_ENABLED
+    if (!touch_controls_active()) { return; }
+
+    sScreenW = (float) djui_hud_get_screen_width();
+    sScreenH = (float) djui_hud_get_screen_height();
+    if (sScreenW < 1 || sScreenH < 1) { return; }
+
+    // Claude64 purple (matches the logo)
+    for (int i = 0; i < TB_COUNT; i++) {
+        float cx, cy;
+        button_center(i, &cx, &cy);
+        float r = sButtons[i].r * sScreenH;
+        if (sButtonDown[i]) { djui_hud_set_color(190, 120, 255, 190); }
+        else                { djui_hud_set_color(130, 40, 190, 110); }
+        render_blob(cx, cy, r);
+        djui_hud_set_color(255, 255, 255, sButtonDown[i] ? 255 : 200);
+        djui_hud_set_font(FONT_NORMAL);
+        render_label(sButtons[i].label, cx, cy, sScreenH);
+    }
+
+    // stick: ring at the origin (or a resting spot) and a knob on the finger
+    float baseX, baseY, knobX, knobY;
+    float R = STICK_RADIUS * sScreenH;
+    if (sStickActive) {
+        baseX = sStickOriginX; baseY = sStickOriginY;
+        knobX = sStickKnobX;   knobY = sStickKnobY;
+    } else {
+        baseX = knobX = 0.20f * sScreenH + 0.05f * sScreenH;
+        baseY = knobY = sScreenH - 0.26f * sScreenH;
+    }
+    djui_hud_set_color(130, 40, 190, sStickActive ? 90 : 55);
+    render_blob(baseX, baseY, R * 1.05f);
+    djui_hud_set_color(190, 120, 255, sStickActive ? 200 : 110);
+    render_blob(knobX, knobY, R * 0.42f);
+    djui_hud_reset_color();
+#endif
+}
