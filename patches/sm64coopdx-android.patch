+#ifndef CONTROLLER_TOUCH_H
+#define CONTROLLER_TOUCH_H
+
+// Claude64: on-screen touch controls (virtual stick, A/B/Z, C buttons, R, Start, Menu).
+// Compiled on every platform; only active when built with TARGET_ANDROID or ENABLE_TOUCH_CONTROLS.
+
+#include <stdbool.h>
+#include <SDL2/SDL.h>
+#include "controller_api.h"
+
+#define VK_BASE_TOUCH 0x2000
+
+extern struct ControllerAPI controller_touch;
+
+// Feed SDL_FINGERDOWN / SDL_FINGERMOTION / SDL_FINGERUP events from the window backend.
+void touch_controls_handle_event(const SDL_Event *event);
+// Draws the overlay with the DJUI HUD helpers (called from djui_render).
+void touch_controls_render(void);
+// True while the overlay is visible and consuming touches.
+bool touch_controls_active(void);
+
+#endif
